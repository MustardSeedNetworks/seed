[Unit]
Description=Seed - Network Diagnostic Tool
Documentation=https://github.com/MustardSeedNetworks/seed
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seed
Group=seed
WorkingDirectory=/var/lib/seed
ExecStart=/usr/bin/seed serve
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
# Grant network capabilities for ICMP ping, ARP scanning, packet capture, and link config,
# and for the operator-started TFTP session, which must answer on UDP 69
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem protection
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/seed /var/lib/seed /var/log/seed
PrivateTmp=yes

# Additional hardening
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
PrivateDevices=no
# Note: PrivateDevices=no required for network interface access

# Environment
Environment=HOME=/var/lib/seed

[Install]
WantedBy=multi-user.target
