<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.mustardseed.seed.wifihelper</string>

    <!-- A LaunchAgent, not a LaunchDaemon. Location Services authorization is
         granted per user inside a login session, which is the whole reason this
         process exists separately from the seed daemon.

         Launched through LaunchServices rather than by naming the executable
         inside the bundle. CoreWLAN redacts SSID and BSSID according to the
         calling process's client identity, and a directly-executed inner binary
         registers as com.apple.locationd.executable-<path> — a different client
         from the bundle, holding no grant. The scan then succeeds and returns
         nothing identifiable. `open -W` keeps launchd's view of the process
         lifetime correct, and --args passes through to the binary. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-W</string>
        <string>-a</string>
        <string>/Library/Application Support/Seed/Seed Wi-Fi Helper.app</string>
        <string>--args</string>
        <string>-socket</string>
        <string>/var/run/seed/wifi-helper.sock</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- The agent may start before the daemon is listening, which is normal at
         login; it retries rather than exiting, so throttle restarts modestly. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/tmp/seed-wifi-helper.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/seed-wifi-helper.error.log</string>
</dict>
</plist>
