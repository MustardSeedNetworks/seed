        },
        "rescanIntervalMs": {
          "type": "integer"
        },
        "profilingStatus": {
          "$ref": "#/$defs/ProfilingStatus"
        },
        "degradationStatus": {
          "$ref": "#/$defs/DegradationStatus"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "running",
        "scanning",
        "deviceCount",
        "lastScan",
        "subnet",
        "subnets",
        "localIP",
        "interface",
        "activeMethods",
