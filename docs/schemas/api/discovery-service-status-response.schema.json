        "healthyMethods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "failedMethods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "recommendations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "overallHealth",
        "healthyMethods",
        "failedMethods",
        "warnings",
        "recommendations"
      ]
