        "subnet": {
          "type": "string"
        },
        "subnets": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "localIP": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "activeMethods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "snmpProbe": {
