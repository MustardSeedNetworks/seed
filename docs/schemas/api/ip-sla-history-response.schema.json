    },
    "IPSLARunResponse": {
      "properties": {
        "sampledAt": {
          "type": "string",
          "format": "date-time"
        },
        "runs": {
          "type": "integer"
        },
        "completedPct": {
          "type": "number"
        },
        "rttMs": {
          "type": "number"
        },
        "jitterMs": {
          "type": "number"
        },
        "lossPct": {
          "type": "number"
        },
        "mos": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "sampledAt",
        "runs",
        "completedPct"
