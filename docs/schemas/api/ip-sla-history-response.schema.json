{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MustardSeedNetworks/seed/main/docs/schemas/api/ip-sla-history-response.schema.json",
  "$ref": "#/$defs/IPSLAHistoryResponse",
  "$defs": {
    "IPSLAHistoryResponse": {
      "properties": {
        "targetId": {
          "type": "string"
        },
        "index": {
          "type": "integer"
        },
        "range": {
          "type": "string",
          "enum": [
            "1h",
            "24h",
            "7d"
          ]
        },
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "bucketSeconds": {
          "type": "number"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/IPSLARunResponse"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "targetId",
        "index",
        "range",
        "from",
        "to",
        "bucketSeconds",
        "points"
