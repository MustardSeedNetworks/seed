{
  "name": "seed-ui",
  "version": "0.212.3",
  "private": true,
  "type": "module",
  "description": "The Seed WebUI - Network Diagnostics - Mustard Seed Networks",
  "engines": {
    "node": "26.7.0",
    "npm": "12.0.2"
  },
  "scripts": {
    "dev": "node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js",
    "gen-types": "node scripts/gen-types.mjs",
    "build": "node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js build",
    "build:analyze": "ANALYZE=true node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js build",
    "typecheck": "tsgo --build --noEmit",
    "preview": "node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js preview",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --reporter=verbose --passWithNoTests",
    "test:watch": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs --reporter=dot",
    "test:coverage": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --coverage --reporter=verbose",
    "test:e2e": "NO_COLOR= node --disable-warning=DEP0205 ./node_modules/playwright/cli.js test --reporter=list",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "npm run build-storybook && npm run test:storybook:run",
    "test:storybook:run": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --config vitest.storybook.config.ts --project=storybook",
    "test:storybook:contract": "../scripts/test-storybook-contract.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@hookform/resolvers": "5.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.101.0",
    "cmdk": "1.1.1",
    "i18next": "26.3.1",
    "i18next-browser-languagedetector": "8.2.1",
    "immer": "11.1.16",
    "jszip": "3.10.1",
    "lucide-react": "1.18.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.79.0",
    "react-i18next": "17.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "valibot": "1.4.2",
    "wouter": "3.10.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@chromatic-com/storybook": "5.2.1",
    "@playwright/test": "1.61.0",
    "@storybook/addon-a11y": "10.4.5",
    "@storybook/addon-docs": "10.4.5",
    "@storybook/addon-onboarding": "10.4.5",
    "@storybook/addon-vitest": "10.4.5",
    "@storybook/react": "10.4.5",
    "@storybook/react-vite": "10.4.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jscodeshift": "17.3.0",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "jscodeshift": "17.3.0",
    "jsdom": "29.1.1",
    "json-schema-to-typescript": "15.0.4",
    "playwright": "1.61.0",
    "postcss": "8.5.26",
    "rollup-plugin-visualizer": "7.0.1",
    "storybook": "10.4.5",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1",
    "fast-uri": "4.1.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  },
  "packageManager": "npm@12.0.2"
}
