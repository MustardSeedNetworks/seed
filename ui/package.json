{
  "name": "seed-ui",
  "version": "0.282.9",
  "private": true,
  "type": "module",
  "description": "The Seed WebUI - Network Diagnostics - Mustard Seed Networks",
  "engines": {
    "node": "26.12.0",
    "npm": "12.2.1"
  },
  "scripts": {
    "dev": "node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js",
    "gen-types": "node scripts/gen-types.mjs",
    "build": "node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js build",
    "build:analyze": "ANALYZE=true node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js build",
    "typecheck": "tsc --build --noEmit",
    "preview": "node --disable-warning=DEP0205 ./node_modules/vite/bin/vite.js preview",
    "lint": "biome check src/ e2e/",
    "lint:fix": "biome check --write src/ e2e/",
    "format": "biome format --write src/ e2e/",
    "test": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --reporter=verbose",
    "test:watch": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs --reporter=dot",
    "test:coverage": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --coverage --reporter=verbose",
    "test:e2e": "NO_COLOR= node --disable-warning=DEP0205 ./node_modules/playwright/cli.js test --reporter=list",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "npm run build-storybook && npm run test:storybook:gated",
    "test:storybook:run": "node --disable-warning=DEP0205 ./node_modules/vitest/vitest.mjs run --config vitest.storybook.config.ts --project=storybook",
    "test:storybook:contract": "../scripts/test-storybook-contract.sh",
    "test:storybook:gated": "../scripts/run-storybook-gated.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-virtual": "3.14.21",
    "cmdk": "1.1.1",
    "i18next": "26.4.7",
    "i18next-browser-languagedetector": "8.2.1",
    "immer": "11.1.21",
    "lucide-react": "1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.0.21",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "valibot": "1.5.0",
    "wouter": "3.13.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@chromatic-com/storybook": "5.5.1",
    "@playwright/test": "1.64.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-onboarding": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/jscodeshift": "17.3.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jscodeshift": "17.4.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "msw": "3.0.3",
    "playwright": "1.64.0",
    "postcss": "8.5.30",
    "rollup-plugin-visualizer": "7.1.1",
    "storybook": "10.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "esbuild": "0.28.2",
    "fast-uri": "4.2.3",
    "js-yaml": "5.5.0",
    "nanoid": "6.0.2"
  },
  "packageManager": "npm@12.2.1",
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
